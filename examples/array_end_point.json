{
  "version": 1,
  "doc": "Array end point control example; source geometry retains its local pivot.",
  "nodes": {
    "source": {
      "type": "box",
      "params": {
        "size": [
          1,
          0.5,
          0.5
        ]
      },
      "pos": [
        0,
        0
      ]
    },
    "array": {
      "type": "array",
      "inputs": {
        "source": "source"
      },
      "pos": [
        0,
        130
      ],
      "params": {
        "count": 5,
        "use_end_point": true,
        "origin": [
          -2,
          -1,
          0
        ],
        "end": [
          2,
          1,
          3
        ]
      }
    },
    "out": {
      "type": "output",
      "inputs": {
        "geo": "array"
      },
      "pos": [
        0,
        260
      ]
    }
  },
  "display": "out"
}
